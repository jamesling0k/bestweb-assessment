{
  "openapi": "3.0.3",
  "info": {
    "title": "BestWeb Product API",
    "version": "1.0.0",
    "description": "Administrator-only API. Obtain a bearer token with POST /api/tokens. Tokens expire after 24 hours. Send Accept: application/json. Updates and Excel export are available in the Blade dashboard. Products are soft-deleted. Login: 5 requests/minute per email/IP. Protected endpoints: 60 requests/minute per user."
  },
  "servers": [{ "url": "/", "description": "Current application host" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "Authentication" }, { "name": "Products" }],
  "paths": {
    "/api/tokens": {
      "post": {
        "operationId": "createToken",
        "tags": ["Authentication"],
        "summary": "Sign in as an administrator",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["email", "password"],
            "properties": {
              "email": { "type": "string", "format": "email", "maxLength": 255, "example": "admin@example.test" },
              "password": { "type": "string", "format": "password", "maxLength": 255, "example": "your-local-admin-password" }
            }
          } } }
        },
        "responses": {
          "201": { "description": "Token issued. The plain token is returned only once.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/tokens/current": {
      "delete": {
        "operationId": "revokeToken", "tags": ["Authentication"], "summary": "Revoke the current bearer token",
        "responses": {
          "200": { "description": "Token revoked.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" }, "example": { "message": "Token revoked." } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/products": {
      "get": {
        "operationId": "listProducts", "tags": ["Products"], "summary": "List products",
        "description": "Includes enabled and disabled products for admins. Excludes soft-deleted products. Ordered by ID descending.",
        "parameters": [
          { "name": "category_id", "in": "query", "description": "Existing category ID.", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "enabled", "in": "query", "description": "1: enabled; 0: disabled.", "schema": { "type": "integer", "enum": [0, 1] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 15 } }
        ],
        "responses": {
          "200": { "description": "Paginated products.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "operationId": "createProduct", "tags": ["Products"], "summary": "Create a product",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductInput" } } } },
        "responses": {
          "201": { "description": "Product created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/products/{product}": {
      "parameters": [{ "name": "product", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64", "minimum": 1 }, "example": 1 }],
      "get": {
        "operationId": "showProduct", "tags": ["Products"], "summary": "Get product details",
        "responses": {
          "200": { "description": "Product details.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "delete": {
        "operationId": "deleteProduct", "tags": ["Products"], "summary": "Soft-delete a product",
        "responses": {
          "200": { "description": "Product deleted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/products/bulk": {
      "delete": {
        "operationId": "bulkDeleteProducts", "tags": ["Products"], "summary": "Soft-delete selected products",
        "description": "IDs must be distinct, exist and not already be deleted. Invalid requests do not delete any products.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "required": ["ids"],
          "properties": { "ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "example": [1, 2] } }
        } } } },
        "responses": {
          "200": { "description": "Selected products deleted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkDeleteResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Paste the token returned by POST /api/tokens. Swagger adds the Bearer prefix." } },
    "responses": {
      "Unauthenticated": { "description": "Missing, invalid, expired or revoked bearer token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "Unauthenticated." } } } },
      "Forbidden": { "description": "Administrator access required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "Administrator access required." } } } },
      "NotFound": { "description": "Product not found, including soft-deleted products.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "Not Found" } } } },
      "ValidationFailed": { "description": "Input validation failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } },
      "RateLimited": { "description": "Too many requests.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "message": "Too Many Attempts." } } } }
    },
    "schemas": {
      "ProductInput": {
        "type": "object", "required": ["name", "category_id", "description", "price", "stock", "enabled"],
        "properties": {
          "name": { "type": "string", "maxLength": 255, "example": "Desk lamp" },
          "category_id": { "type": "integer", "format": "int64", "minimum": 1, "description": "Existing category ID. Available categories are shown in the admin form.", "example": 1 },
          "description": { "type": "string", "maxLength": 10000, "example": "Adjustable desk lamp." },
          "price": { "type": "number", "minimum": 0, "maximum": 9999999999.99, "multipleOf": 0.01, "description": "At most two decimal places; stored as DECIMAL(12,2).", "example": 49.9 },
          "stock": { "type": "integer", "minimum": 0, "maximum": 4294967295, "example": 12 },
          "enabled": { "type": "boolean", "example": true }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "category_id", "category_name", "description", "price", "stock", "enabled", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "category_id": { "type": "integer", "format": "int64" },
          "category_name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "string", "pattern": "^\\d+\\.\\d{2}$", "description": "Decimal string to preserve precision." },
          "stock": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "example": { "id": 1, "name": "Desk lamp", "category_id": 1, "category_name": "Office", "description": "Adjustable desk lamp.", "price": "49.90", "stock": 12, "enabled": true, "created_at": "2026-10-27T00:00:00.000000Z", "updated_at": "2026-10-27T00:00:00.000000Z" }
      },
      "ProductResponse": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/Product" } } },
      "ProductPage": {
        "type": "object", "required": ["data", "links", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "links": { "type": "object", "properties": { "first": { "type": "string", "nullable": true }, "last": { "type": "string", "nullable": true }, "prev": { "type": "string", "nullable": true }, "next": { "type": "string", "nullable": true } } },
          "meta": { "type": "object", "properties": { "current_page": { "type": "integer" }, "last_page": { "type": "integer" }, "per_page": { "type": "integer" }, "total": { "type": "integer" }, "from": { "type": "integer", "nullable": true }, "to": { "type": "integer", "nullable": true }, "path": { "type": "string" }, "links": { "type": "array", "items": { "type": "object" } } } }
        },
        "example": { "data": [], "links": { "first": "/api/products?page=1", "last": "/api/products?page=1", "prev": null, "next": null }, "meta": { "current_page": 1, "last_page": 1, "per_page": 15, "total": 0, "from": null, "to": null, "path": "/api/products" } }
      },
      "TokenResponse": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["token", "token_type", "expires_in"], "properties": { "token": { "type": "string", "example": "1|example-token" }, "token_type": { "type": "string", "example": "Bearer" }, "expires_in": { "type": "integer", "example": 86400 } } } } },
      "Message": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string", "example": "Product deleted." } } },
      "BulkDeleteResponse": { "type": "object", "required": ["message", "data"], "properties": { "message": { "type": "string", "example": "Products deleted." }, "data": { "type": "object", "required": ["deleted_count"], "properties": { "deleted_count": { "type": "integer", "example": 2 } } } } },
      "Error": { "type": "object", "required": ["message"], "properties": { "message": { "type": "string" } } },
      "ValidationError": { "type": "object", "required": ["message", "errors"], "properties": { "message": { "type": "string", "example": "The name field is required." }, "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "example": { "name": ["The name field is required."] } } } }
    }
  }
}
